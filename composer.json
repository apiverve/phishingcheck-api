        "phishing domain check api",
        "phishing api",
        "phishing url checker",
        "phishing check"
    ],
    "homepage": "https://apiverve.com/marketplace/phishingcheck?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
